<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp" />
    <!--    android:src="R.drawable.exit"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal" /> -->
    <!-- android:contentDescription="Logo"
    android:layout_marginBottom="16dp"/> -->

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtViewLoginTitulo"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/LoginIniciaSesion"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- TEXT BOX 1 -->
    <EditText
        android:id="@+id/txtBoxLoginUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/LoginNombreUsuario"
        android:layout_marginBottom="12dp"/>

    <!-- TEXT BOX 2 -->
    <EditText
        android:id="@+id/txtBoxLoginContrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/LoginContrasena"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp"/>

    <!-- SPINNER (selector de idioma) -->
    <Spinner
        android:id="@+id/spinnerLoginIdiomas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <!-- BOTÓN 1 -->
    <Button
        android:id="@+id/btnLoginIniciarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/LoginBotonIniciarSesion"
        android:layout_marginBottom="8dp"/>


</LinearLayout>
