<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="40dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:layout_marginTop="25dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:padding="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/taskNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:text="Nombre de la tarea (nombre largo)"
            android:maxWidth="285dp"
            android:minHeight="70dp"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@color/principal"
            android:textSize="25sp"/>

        <TextView
            android:id="@+id/taskStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_marginStart="8dp"
            android:text="ESTADO"
            android:textSize="15sp"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:background="@drawable/bg_estado_por_comenzar"
            android:textColor="@android:color/black"
            android:layout_gravity="end"/>

        <TextView
            android:id="@+id/lblInicioTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:text="Inicio:"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lblFinTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:text="Fin:"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lblPrioridadItemTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="2"
            android:text="Prioridad:"
            android:layout_gravity="end"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/startDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:text="XX-XX-XXXX"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/endDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="1"
            android:text="XX-XX-XXXX"
            android:fontFamily="@font/montserrat_medium"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/prioridadImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_gravity="end|bottom"
            android:scaleType="fitCenter"
            android:src="@drawable/prioridad_baja" />

    </GridLayout>

</com.google.android.material.card.MaterialCardView>