<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDetallesTareaMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="@dimen/paddingList">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/paddingList">

        <ImageButton
            android:id="@+id/btnDetalleTareaVolver"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/flecha_hacia_atras"
            android:contentDescription="@string/btnVolver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/principal"
            android:text="@string/tarea"
            android:textSize="@dimen/txtTitulo"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgDetalleTareaLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/paddingList"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/lblDetalleTareaNombreTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_de_tarea"
            android:textColor="@color/principal"
            android:textSize="@dimen/txtSubtitulo"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerDetalleTareaEstado"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner_estado"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/paddingList">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/paddingDiscriptionTarea"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/lblDetalleTareaDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="@dimen/txtNormal"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/subtareas"
            android:textSize="@dimen/txtNormal"
            android:textStyle="bold"
            android:textColor="@color/principal"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetalleTareaSubtareas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/paddingList"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            tools:listitem="@layout/item_mi_tarea" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/usuarios"
            android:textSize="@dimen/txtNormal"
            android:textStyle="bold"
            android:textColor="@color/principal"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetalleTareaUsuariosAsignado"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tarea_rounded"
            android:padding="@dimen/paddingList"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            tools:listitem="@layout/item_usuario" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/paddingList"
        android:layout_marginTop="4dp">

        <!-- Inicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inicio"
                android:textSize="@dimen/txtNormal"
                android:textStyle="bold"
                android:textColor="@color/principal" />

            <TextView
                android:id="@+id/lblDetalleTareaFechaInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/10/2025"
                android:textSize="@dimen/txtNormal"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- Fin -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin"
                android:textSize="@dimen/txtNormal"
                android:textStyle="bold"
                android:textColor="@color/principal" />

            <TextView
                android:id="@+id/lblDetalleTareaFechaFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/10/2025"
                android:textSize="@dimen/txtNormal"
                android:paddingTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
