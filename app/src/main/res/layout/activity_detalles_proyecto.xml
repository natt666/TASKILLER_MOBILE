<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDetallesProyectoMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/margin_borde"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btnDetallesProyectoVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="fitCenter"
            android:src="@drawable/flecha_hacia_atras"
            android:contentDescription="@string/volver" />

        <ImageButton
            android:id="@+id/btnDetallesProyectoAreaPersonal"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_user_ros"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/lblDetallesProyectoNombreProyecto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/principal"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/nombre_proyecto"
        android:textSize="@dimen/txtTitulo"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tarea_rounded"
        android:padding="@dimen/paddingDiscriptionTarea">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/descripci_n"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="@dimen/txtNormal"
            android:textStyle="bold"
            android:textColor="@color/principal" />

        <TextView
            android:id="@+id/lblDetallesProyectoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:text="Descripción"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="@dimen/txtNormal"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listDetallesProyectoListaDeTareas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:padding="@dimen/paddingList"
        tools:listitem="@layout/item_mi_tarea" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/paddingList"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp"
            android:paddingRight="10dp"
            android:paddingLeft="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inicio"
                android:textSize="@dimen/txtNormal"
                android:textStyle="bold"
                android:textColor="@color/principal"
                android:fontFamily="@font/montserrat_medium"/>

            <TextView
                android:id="@+id/lblDetalleProyectoFechaInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/10/2025"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="@dimen/txtNormal"
                android:paddingTop="2dp"
                android:textColor="@color/texto"
                android:paddingBottom="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin"
                android:textSize="@dimen/txtNormal"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="@color/principal" />

            <TextView
                android:id="@+id/lblDetalleProyectoFechaFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/10/2025"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="@dimen/txtNormal"
                android:paddingTop="2dp"
                android:textColor="@color/texto"
                android:paddingBottom="10dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>